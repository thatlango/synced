generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Platform {
  ios
  android
  web
}

enum WalletType {
  personal
  household
}

enum TransactionType {
  credit
  debit
}

enum TransactionSource {
  mtn
  airtel
  sms
  email
  manual
  system
}

enum Visibility {
  personal
  household
  both
}

enum Category {
  food
  transport
  utilities
  subscriptions
  rent
  school_fees
  entertainment
  savings
  healthcare
  shopping
  fuel
  mobile_data
  salary
  transfer
  bill_payment
  other
}

enum BillingCycle {
  daily
  weekly
  monthly
  quarterly
  annually
}

enum SubscriptionStatus {
  active
  paused
  cancelled
}

enum BudgetPeriod {
  daily
  weekly
  monthly
  quarterly
  annually
}

enum OwnerType {
  user
  household
}

enum HouseholdRole {
  admin
  member
}

enum AlertType {
  low_balance
  upcoming_bill
  overspending
  unusual_spending
  budget_exceeded
  subscription_due
}

enum AlertStatus {
  unread
  read
  dismissed
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

enum OtpPurpose {
  signup
  login
  reset
}

enum InviteTargetType {
  household
  basket
}

enum InviteRole {
  member
  contributor
  viewer
}

enum InviteStatus {
  active
  exhausted
  revoked
  expired
}

enum BasketRole {
  owner
  contributor
  viewer
}

enum BasketStatus {
  active
  completed
  paused
  archived
}

enum PlanStatus {
  draft
  active
  closed
}

enum FinancialRuleStatus {
  active
  paused
}

enum FinancialRuleAction {
  categorize
  exclude_from_analytics
  allocate_to_basket
}

enum DebtStatus {
  active
  paid_off
  closed
}

enum SharedRequestStatus {
  pending
  approved
  declined
  cancelled
}

enum SettlementStatus {
  pending
  completed
  cancelled
}

// ─────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────

model User {
  id         String    @id @default(uuid())
  phone      String?   @unique
  coreUserId String?   @unique
  email      String?   @unique
  name       String?
  avatar     String?
  platform   Platform  @default(android)
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastLogin  DateTime?

  // Relations
  personalWallet     Wallet?              @relation("PersonalWallet")
  householdMembers   HouseholdMember[]
  createdHouseholds  Household[]          @relation("HouseholdCreator")
  ledgerEntries      LedgerEntry[]
  subscriptions      Subscription[]
  budgets            Budget[]
  alerts             Alert[]
  otps               Otp[]
  payments           Payment[]
  transactions       Transaction[]
  basketMemberships  BasketMember[]
  basketContributions BasketContribution[]
  createdBaskets     Basket[]              @relation("BasketCreator")
  createdInvites     Invite[]              @relation("InviteCreator")
  redeemedInvites    InviteRedemption[]
  plans              Plan[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// OTP
// ─────────────────────────────────────────────────────────────

model Otp {
  id        String     @id @default(uuid())
  userId    String?
  phone     String
  code      String
  purpose   OtpPurpose @default(login)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

// ─────────────────────────────────────────────────────────────
// HOUSEHOLDS
// ─────────────────────────────────────────────────────────────

model Household {
  id          String   @id @default(uuid())
  name        String
  inviteCode  String   @unique @default(uuid())
  createdBy   String
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User              @relation("HouseholdCreator", fields: [createdBy], references: [id])
  members     HouseholdMember[]
  wallet      Wallet?           @relation("HouseholdWallet")
  budgets     Budget[]
  subscriptions Subscription[]
  bills       Bill[]
  baskets     Basket[]
  invites     Invite[]
  plans       Plan[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid())
  householdId String
  userId      String
  role        HouseholdRole @default(member)
  joinedAt    DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@map("household_members")
}

// ─────────────────────────────────────────────────────────────
// WALLETS
// ─────────────────────────────────────────────────────────────

model Wallet {
  id          String     @id @default(uuid())
  type        WalletType
  balance     Decimal    @default(0) @db.Decimal(18, 2)
  currency    String     @default("UGX")
  userId      String?    @unique
  householdId String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User?       @relation("PersonalWallet", fields: [userId], references: [id], onDelete: Cascade)
  household   Household?  @relation("HouseholdWallet", fields: [householdId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  transactions  Transaction[]

  @@map("wallets")
}

// ─────────────────────────────────────────────────────────────
// TRANSACTIONS (High-level abstraction)
// ─────────────────────────────────────────────────────────────

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  userId      String
  type        TransactionType
  amount      Decimal           @db.Decimal(18, 2)
  category    Category          @default(other)
  description String?
  merchant    String?
  source      TransactionSource @default(manual)
  visibility  Visibility        @default(personal)
  referenceId String?           @unique
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  wallet      Wallet      @relation(fields: [walletId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  ledgerEntry LedgerEntry?

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([category])
  @@map("transactions")
}

// ─────────────────────────────────────────────────────────────
// LEDGER ENTRIES (Immutable audit log)
// ─────────────────────────────────────────────────────────────

model LedgerEntry {
  id            String            @id @default(uuid())
  walletId      String
  userId        String
  transactionId String?           @unique
  type          TransactionType
  amount        Decimal           @db.Decimal(18, 2)
  balanceBefore Decimal           @db.Decimal(18, 2)
  balanceAfter  Decimal           @db.Decimal(18, 2)
  category      Category          @default(other)
  source        TransactionSource @default(manual)
  visibility    Visibility        @default(personal)
  referenceId   String?
  description   String?
  createdAt     DateTime          @default(now())

  wallet      Wallet       @relation(fields: [walletId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@map("ledger_entries")
}

// ─────────────────────────────────────────────────────────────
// SUBSCRIPTIONS
// ─────────────────────────────────────────────────────────────

model Subscription {
  id          String             @id @default(uuid())
  ownerType   OwnerType
  userId      String?
  householdId String?
  name        String
  category    Category           @default(subscriptions)
  amount      Decimal            @db.Decimal(18, 2)
  currency    String             @default("UGX")
  billingCycle BillingCycle      @default(monthly)
  nextDueDate DateTime
  status      SubscriptionStatus @default(active)
  autoRenew   Boolean            @default(true)
  logo        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────
// BILLS
// ─────────────────────────────────────────────────────────────

model Bill {
  id          String        @id @default(uuid())
  ownerType   OwnerType
  userId      String?
  householdId String?
  name        String
  category    Category      @default(utilities)
  amount      Decimal       @db.Decimal(18, 2)
  currency    String        @default("UGX")
  dueDate     DateTime
  isPaid      Boolean       @default(false)
  paidAt      DateTime?
  recurring   Boolean       @default(false)
  billingCycle BillingCycle?
  provider    String?
  accountRef  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([dueDate])
  @@map("bills")
}

// ─────────────────────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(uuid())
  userId      String
  walletId    String?
  billId      String?
  amount      Decimal       @db.Decimal(18, 2)
  currency    String        @default("UGX")
  provider    String
  accountRef  String?
  status      PaymentStatus @default(pending)
  referenceId String?       @unique
  failReason  String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User  @relation(fields: [userId], references: [id])
  bill Bill? @relation(fields: [billId], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// BUDGETS
// ─────────────────────────────────────────────────────────────

model Budget {
  id          String       @id @default(uuid())
  ownerType   OwnerType
  userId      String?
  householdId String?
  category    Category
  limitAmount Decimal      @db.Decimal(18, 2)
  currency    String       @default("UGX")
  period      BudgetPeriod @default(monthly)
  startDate   DateTime     @default(now())
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([ownerType, userId, householdId, category, period])
  @@map("budgets")
}

// ─────────────────────────────────────────────────────────────
// PLANS
// ─────────────────────────────────────────────────────────────

model Plan {
  id             String     @id @default(uuid())
  userId         String?
  householdId    String?
  label          String
  currency       String     @default("UGX")
  expectedIncome Decimal    @default(0) @db.Decimal(18, 2)
  startDate      DateTime
  endDate        DateTime
  status         PlanStatus @default(active)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household?       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  allocations PlanAllocation[]

  @@index([userId, startDate, endDate])
  @@index([householdId, startDate, endDate])
  @@map("plans")
}

model PlanAllocation {
  id            String   @id @default(uuid())
  planId        String
  label         String
  category      Category?
  plannedAmount Decimal  @db.Decimal(18, 2)
  basketId      String?
  billId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plan   Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  basket Basket? @relation(fields: [basketId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@map("plan_allocations")
}

// ─────────────────────────────────────────────────────────────
// BASKETS — personal/shared purpose pools
// ─────────────────────────────────────────────────────────────

model Basket {
  id             String       @id @default(uuid())
  name           String
  description    String?
  currency       String       @default("UGX")
  targetAmount   Decimal?     @db.Decimal(18, 2)
  targetDate     DateTime?
  createdBy      String
  householdId    String?
  status         BasketStatus @default(active)
  colorKey       String?      @default("violet")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  creator       User                 @relation("BasketCreator", fields: [createdBy], references: [id])
  household     Household?           @relation(fields: [householdId], references: [id], onDelete: SetNull)
  members       BasketMember[]
  contributions BasketContribution[]
  invites       Invite[]
  allocations   PlanAllocation[]

  @@index([createdBy, status])
  @@index([householdId, status])
  @@map("baskets")
}

model BasketMember {
  id        String     @id @default(uuid())
  basketId  String
  userId    String
  role      BasketRole @default(contributor)
  joinedAt  DateTime   @default(now())

  basket Basket @relation(fields: [basketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([basketId, userId])
  @@map("basket_members")
}

model BasketContribution {
  id            String   @id @default(uuid())
  basketId      String
  userId        String
  amount        Decimal  @db.Decimal(18, 2)
  source        String   @default("manual")
  transactionId String?
  note          String?
  contributedAt DateTime @default(now())

  basket Basket @relation(fields: [basketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([basketId, contributedAt])
  @@map("basket_contributions")
}

// ─────────────────────────────────────────────────────────────
// INVITES — scope-aware code/link/QR joining
// ─────────────────────────────────────────────────────────────

model Invite {
  id           String           @id @default(uuid())
  code         String           @unique
  targetType   InviteTargetType
  role         InviteRole       @default(member)
  householdId  String?
  basketId     String?
  createdBy    String
  status       InviteStatus     @default(active)
  maxUses      Int              @default(1)
  useCount     Int              @default(0)
  expiresAt    DateTime?
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  creator     User               @relation("InviteCreator", fields: [createdBy], references: [id])
  household   Household?         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  basket      Basket?            @relation(fields: [basketId], references: [id], onDelete: Cascade)
  redemptions InviteRedemption[]

  @@index([code, status])
  @@map("invites")
}

model InviteRedemption {
  id         String   @id @default(uuid())
  inviteId   String
  userId     String
  redeemedAt DateTime @default(now())

  invite Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
  @@map("invite_redemptions")
}

// ─────────────────────────────────────────────────────────────
// ALERTS / NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

model Alert {
  id        String      @id @default(uuid())
  userId    String
  type      AlertType
  title     String
  message   String
  metadata  Json?
  status    AlertStatus @default(unread)
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("alerts")
}

// ─────────────────────────────────────────────────────────────
// RECONCILIATION LOGS
// ─────────────────────────────────────────────────────────────

model ReconciliationLog {
  id            String   @id @default(uuid())
  walletId      String
  date          DateTime @default(now())
  openingBalance Decimal @db.Decimal(18, 2)
  closingBalance Decimal @db.Decimal(18, 2)
  totalCredits  Decimal  @db.Decimal(18, 2)
  totalDebits   Decimal  @db.Decimal(18, 2)
  discrepancy   Decimal  @db.Decimal(18, 2) @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  @@map("reconciliation_logs")
}

// ─────────────────────────────────────────────────────────────
// FINANCIAL INTELLIGENCE / CROSS-PLATFORM STATE
// ─────────────────────────────────────────────────────────────

model FinancialRule {
  id                String              @id @default(uuid())
  userId            String
  name              String
  matchMerchant     String?
  matchDescription  String?
  matchSource       TransactionSource?
  minAmount         Decimal?            @db.Decimal(18, 2)
  maxAmount         Decimal?            @db.Decimal(18, 2)
  action            FinancialRuleAction
  category          Category?
  basketId          String?
  allocationPercent Int?
  priority          Int                 @default(100)
  status            FinancialRuleStatus @default(active)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId, status, priority])
  @@map("financial_rules")
}

model MerchantPreference {
  id                    String   @id @default(uuid())
  userId                String
  merchantKey           String
  displayName           String?
  category              Category
  excludedFromAnalytics Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, merchantKey])
  @@index([userId, category])
  @@map("merchant_preferences")
}

model DebtAccount {
  id                 String     @id @default(uuid())
  userId             String
  name               String
  lender             String?
  currency           String     @default("UGX")
  principal          Decimal?   @db.Decimal(18, 2)
  outstandingBalance Decimal    @default(0) @db.Decimal(18, 2)
  dueAmount          Decimal?   @db.Decimal(18, 2)
  nextDueDate        DateTime?
  interestRate       Decimal?   @db.Decimal(7, 4)
  status             DebtStatus @default(active)
  metadata           Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  payments DebtPayment[]

  @@index([userId, status, nextDueDate])
  @@map("debt_accounts")
}

model DebtPayment {
  id              String   @id @default(uuid())
  debtId          String
  userId          String
  amount          Decimal  @db.Decimal(18, 2)
  principalAmount Decimal? @db.Decimal(18, 2)
  interestAmount  Decimal? @db.Decimal(18, 2)
  feeAmount       Decimal? @db.Decimal(18, 2)
  penaltyAmount   Decimal? @db.Decimal(18, 2)
  transactionId   String?
  paidAt          DateTime @default(now())
  createdAt       DateTime @default(now())

  debt DebtAccount @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([userId, paidAt])
  @@map("debt_payments")
}

model DeviceRegistration {
  id         String   @id @default(uuid())
  userId     String
  platform   Platform
  token      String   @unique
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, enabled])
  @@map("device_registrations")
}

model SharedExpenseRequest {
  id            String              @id @default(uuid())
  householdId   String
  requestedBy   String
  amount        Decimal             @db.Decimal(18, 2)
  currency      String              @default("UGX")
  description   String
  category      Category?
  status        SharedRequestStatus @default(pending)
  decidedBy     String?
  decidedAt     DateTime?
  transactionId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([householdId, status, createdAt])
  @@map("shared_expense_requests")
}

model HouseholdSettlement {
  id          String           @id @default(uuid())
  householdId String
  fromUserId  String
  toUserId    String
  amount      Decimal          @db.Decimal(18, 2)
  currency    String           @default("UGX")
  status      SettlementStatus @default(pending)
  note        String?
  settledAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([householdId, status, createdAt])
  @@map("household_settlements")
}
