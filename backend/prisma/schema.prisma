generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Platform {
  ios
  android
  web
}

enum WalletType {
  personal
  household
}

enum TransactionType {
  credit
  debit
}

enum TransactionSource {
  mtn
  airtel
  sms
  email
  manual
  system
}

enum Visibility {
  personal
  household
  both
}

enum Category {
  food
  transport
  utilities
  subscriptions
  rent
  school_fees
  entertainment
  savings
  healthcare
  shopping
  fuel
  mobile_data
  salary
  transfer
  bill_payment
  other
}

enum BillingCycle {
  daily
  weekly
  monthly
  quarterly
  annually
}

enum SubscriptionStatus {
  active
  paused
  cancelled
}

enum BudgetPeriod {
  daily
  weekly
  monthly
  quarterly
  annually
}

enum OwnerType {
  user
  household
}

enum HouseholdRole {
  admin
  member
}

enum AlertType {
  low_balance
  upcoming_bill
  overspending
  unusual_spending
  budget_exceeded
  subscription_due
}

enum AlertStatus {
  unread
  read
  dismissed
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

enum OtpPurpose {
  signup
  login
  reset
}

// ─────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────

model User {
  id         String    @id @default(uuid())
  phone      String    @unique
  email      String?   @unique
  name       String?
  avatar     String?
  platform   Platform  @default(android)
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastLogin  DateTime?

  // Relations
  personalWallet     Wallet?              @relation("PersonalWallet")
  householdMembers   HouseholdMember[]
  createdHouseholds  Household[]          @relation("HouseholdCreator")
  ledgerEntries      LedgerEntry[]
  subscriptions      Subscription[]
  budgets            Budget[]
  alerts             Alert[]
  otps               Otp[]
  payments           Payment[]
  transactions       Transaction[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// OTP
// ─────────────────────────────────────────────────────────────

model Otp {
  id        String     @id @default(uuid())
  userId    String?
  phone     String
  code      String
  purpose   OtpPurpose @default(login)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

// ─────────────────────────────────────────────────────────────
// HOUSEHOLDS
// ─────────────────────────────────────────────────────────────

model Household {
  id          String   @id @default(uuid())
  name        String
  inviteCode  String   @unique @default(uuid())
  createdBy   String
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User              @relation("HouseholdCreator", fields: [createdBy], references: [id])
  members     HouseholdMember[]
  wallet      Wallet?           @relation("HouseholdWallet")
  budgets     Budget[]
  subscriptions Subscription[]
  bills       Bill[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid())
  householdId String
  userId      String
  role        HouseholdRole @default(member)
  joinedAt    DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@map("household_members")
}

// ─────────────────────────────────────────────────────────────
// WALLETS
// ─────────────────────────────────────────────────────────────

model Wallet {
  id          String     @id @default(uuid())
  type        WalletType
  balance     Decimal    @default(0) @db.Decimal(18, 2)
  currency    String     @default("UGX")
  userId      String?    @unique
  householdId String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User?       @relation("PersonalWallet", fields: [userId], references: [id], onDelete: Cascade)
  household   Household?  @relation("HouseholdWallet", fields: [householdId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  transactions  Transaction[]

  @@map("wallets")
}

// ─────────────────────────────────────────────────────────────
// TRANSACTIONS (High-level abstraction)
// ─────────────────────────────────────────────────────────────

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  userId      String
  type        TransactionType
  amount      Decimal           @db.Decimal(18, 2)
  category    Category          @default(other)
  description String?
  merchant    String?
  source      TransactionSource @default(manual)
  visibility  Visibility        @default(personal)
  referenceId String?           @unique
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  wallet      Wallet      @relation(fields: [walletId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  ledgerEntry LedgerEntry?

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([category])
  @@map("transactions")
}

// ─────────────────────────────────────────────────────────────
// LEDGER ENTRIES (Immutable audit log)
// ─────────────────────────────────────────────────────────────

model LedgerEntry {
  id            String            @id @default(uuid())
  walletId      String
  userId        String
  transactionId String?           @unique
  type          TransactionType
  amount        Decimal           @db.Decimal(18, 2)
  balanceBefore Decimal           @db.Decimal(18, 2)
  balanceAfter  Decimal           @db.Decimal(18, 2)
  category      Category          @default(other)
  source        TransactionSource @default(manual)
  visibility    Visibility        @default(personal)
  referenceId   String?
  description   String?
  createdAt     DateTime          @default(now())

  wallet      Wallet       @relation(fields: [walletId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@map("ledger_entries")
}

// ─────────────────────────────────────────────────────────────
// SUBSCRIPTIONS
// ─────────────────────────────────────────────────────────────

model Subscription {
  id          String             @id @default(uuid())
  ownerType   OwnerType
  userId      String?
  householdId String?
  name        String
  category    Category           @default(subscriptions)
  amount      Decimal            @db.Decimal(18, 2)
  currency    String             @default("UGX")
  billingCycle BillingCycle      @default(monthly)
  nextDueDate DateTime
  status      SubscriptionStatus @default(active)
  autoRenew   Boolean            @default(true)
  logo        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────
// BILLS
// ─────────────────────────────────────────────────────────────

model Bill {
  id          String        @id @default(uuid())
  ownerType   OwnerType
  userId      String?
  householdId String?
  name        String
  category    Category      @default(utilities)
  amount      Decimal       @db.Decimal(18, 2)
  currency    String        @default("UGX")
  dueDate     DateTime
  isPaid      Boolean       @default(false)
  paidAt      DateTime?
  recurring   Boolean       @default(false)
  billingCycle BillingCycle?
  provider    String?
  accountRef  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([dueDate])
  @@map("bills")
}

// ─────────────────────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(uuid())
  userId      String
  walletId    String?
  billId      String?
  amount      Decimal       @db.Decimal(18, 2)
  currency    String        @default("UGX")
  provider    String
  accountRef  String?
  status      PaymentStatus @default(pending)
  referenceId String?       @unique
  failReason  String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User  @relation(fields: [userId], references: [id])
  bill Bill? @relation(fields: [billId], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// BUDGETS
// ─────────────────────────────────────────────────────────────

model Budget {
  id          String       @id @default(uuid())
  ownerType   OwnerType
  userId      String?
  householdId String?
  category    Category
  limitAmount Decimal      @db.Decimal(18, 2)
  currency    String       @default("UGX")
  period      BudgetPeriod @default(monthly)
  startDate   DateTime     @default(now())
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([ownerType, userId, householdId, category, period])
  @@map("budgets")
}

// ─────────────────────────────────────────────────────────────
// ALERTS / NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

model Alert {
  id        String      @id @default(uuid())
  userId    String
  type      AlertType
  title     String
  message   String
  metadata  Json?
  status    AlertStatus @default(unread)
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("alerts")
}

// ─────────────────────────────────────────────────────────────
// RECONCILIATION LOGS
// ─────────────────────────────────────────────────────────────

model ReconciliationLog {
  id            String   @id @default(uuid())
  walletId      String
  date          DateTime @default(now())
  openingBalance Decimal @db.Decimal(18, 2)
  closingBalance Decimal @db.Decimal(18, 2)
  totalCredits  Decimal  @db.Decimal(18, 2)
  totalDebits   Decimal  @db.Decimal(18, 2)
  discrepancy   Decimal  @db.Decimal(18, 2) @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  @@map("reconciliation_logs")
}
