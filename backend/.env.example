# App
NODE_ENV=development
PORT=3000
APP_NAME=Synced

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synced_db?schema=public"

# JWT
JWT_SECRET=synced-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MTN MoMo API (Mock)
MTN_API_KEY=mock_mtn_api_key
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=mock_subscription_key

# Airtel Money API (Mock)
AIRTEL_API_KEY=mock_airtel_api_key
AIRTEL_BASE_URL=https://openapi.airtel.africa

# SMS Gateway
SMS_GATEWAY_URL=https://sms.gateway.mock
SMS_API_KEY=mock_sms_key

# OTP (set to true in dev to skip real OTP sending)
OTP_MOCK=true
OTP_EXPIRY_MINUTES=5

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100
